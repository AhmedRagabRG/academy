NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alsalam_test
JWT_ACCESS_SECRET=test-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3001
UPLOAD_DIR=uploads-test
UPLOAD_MAX_BYTES=5242880
FILES_PUBLIC_BASE_URL=/files
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=test-password-only
SWAGGER_ENABLED=false
PASSWORD_MIN_LENGTH=12
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_MESSENGER_PAGE_ACCESS_TOKEN=
META_MESSENGER_PAGE_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
# Optional Redis endpoint used only when AI_QUEUE_ENABLED=true
REDIS_URL=
# Optional OpenAI credentials and model settings; AI remains off by default
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Truncated to remain compatible with a future pgvector HNSW index
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# AI behavior and queue connections are independently opt-in
AI_ENABLED=false
AI_QUEUE_ENABLED=false
