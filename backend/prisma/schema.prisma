generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationContactType {
  EMAIL
  PHONE
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING
  REVIEW
  DONE
  ARCHIVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id                     String                   @id @default(uuid()) @db.Uuid
  singletonKey           String                   @unique @default("PRIMARY")
  code                   String                   @unique
  name                   String
  logo                   Json?
  favicon                Json?
  cover                  Json?
  website                String?
  address                String?
  workingHours           Json
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @db.Timestamptz
  updatedAt              DateTime                 @updatedAt @db.Timestamptz
  createdBy              String?                  @db.Uuid
  updatedBy              String?                  @db.Uuid
  contacts               OrganizationContact[]
  socialLinks            OrganizationSocialLink[]
  generalSettings        GeneralSettings?
  lookupGroups           LookupGroup[]
  inboxPlatforms         InboxPlatform[]
  inboxTags              InboxTag[]
  inboxCustomers         InboxCustomer[]
  inboxConversations     InboxConversation[]
  inboxStagedAttachments InboxStagedAttachment[]
  inboxChannels          InboxChannelConnection[]
  crmContacts            Contact[]
  contactGroups          ContactGroup[]
  contactFields          ContactCustomField[]
  pipelines              Pipeline[]
  leads                  Lead[]
  whatsappTemplates      WhatsappTemplate[]
  campaigns              Campaign[]
}

model OrganizationContact {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           OrganizationContactType
  label          String
  value          String
  isPrimary      Boolean                 @default(false)
  sortOrder      Int                     @default(0)

  @@index([organizationId, type, sortOrder])
}

model OrganizationSocialLink {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       String
  url            String
  sortOrder      Int          @default(0)

  @@unique([organizationId, platform])
  @@index([organizationId, sortOrder])
}

model GeneralSettings {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultLanguage String
  timeZone        String
  currency        String
  dateFormat      String
  numberFormat    String
  workingDays     String[]
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  createdBy       String?      @db.Uuid
  updatedBy       String?      @db.Uuid
}

model LookupGroup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  normalizedName String
  parentGroupId  String?       @db.Uuid
  parentGroup    LookupGroup?  @relation("LookupGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  childGroups    LookupGroup[] @relation("LookupGroupHierarchy")
  status         EntityStatus  @default(ACTIVE)
  version        Int           @default(1)
  archivedAt     DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  createdBy      String?       @db.Uuid
  updatedBy      String?       @db.Uuid
  values         LookupValue[]

  @@unique([organizationId, code])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, status])
  @@index([parentGroupId])
}

model LookupValue {
  id             String        @id @default(uuid()) @db.Uuid
  lookupGroupId  String        @db.Uuid
  lookupGroup    LookupGroup   @relation(fields: [lookupGroupId], references: [id], onDelete: Restrict)
  parentValueId  String?       @db.Uuid
  parentValue    LookupValue?  @relation("LookupValueHierarchy", fields: [parentValueId], references: [id], onDelete: Restrict)
  childValues    LookupValue[] @relation("LookupValueHierarchy")
  name           String
  normalizedName String
  code           String
  /// Optional prose describing the value. Expense categories carry one; most
  /// lookup groups leave it null.
  description    String?
  sortOrder      Int           @default(0)
  status         EntityStatus  @default(ACTIVE)
  version        Int           @default(1)
  archivedAt     DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  createdBy      String?       @db.Uuid
  updatedBy      String?       @db.Uuid

  @@unique([lookupGroupId, code])
  @@unique([lookupGroupId, normalizedName])
  @@index([lookupGroupId, status, sortOrder])
  @@index([parentValueId])
}

model Role {
  id                    String           @id @default(uuid()) @db.Uuid
  code                  String           @unique
  displayName           String
  normalizedDisplayName String           @unique
  description           String           @default("")
  status                EntityStatus     @default(ACTIVE)
  version               Int              @default(1)
  archivedAt            DateTime?        @db.Timestamptz
  createdAt             DateTime         @default(now()) @db.Timestamptz
  updatedAt             DateTime         @updatedAt @db.Timestamptz
  createdBy             String?          @db.Uuid
  updatedBy             String?          @db.Uuid
  accounts              AccountRole[]
  permissions           RolePermission[]
}

model Account {
  id                         String                   @id @default(uuid()) @db.Uuid
  email                      String                   @unique
  passwordHash               String
  displayName                String
  normalizedDisplayName      String
  phone                      String                   @default("+2000000000")
  position                   String?
  organizationWide           Boolean                  @default(false)
  avatar                     Json?
  status                     EntityStatus             @default(ACTIVE)
  version                    Int                      @default(1)
  archivedAt                 DateTime?                @db.Timestamptz
  createdAt                  DateTime                 @default(now()) @db.Timestamptz
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz
  createdBy                  String?                  @db.Uuid
  updatedBy                  String?                  @db.Uuid
  roles                      AccountRole[]
  refreshTokens              RefreshToken[]
  inboxAssignedConversations InboxConversation[]      @relation("InboxAssignedEmployee")
  inboxNotes                 InboxInternalNote[]
  inboxStagedAttachments     InboxStagedAttachment[]
  inboxChannels              InboxChannelConnection[]
  ownedContacts              Contact[]
  contactNotes               ContactNote[]
  assignedLeads              Lead[]
  createdCampaigns           Campaign[]

  @@index([status])
  @@index([normalizedDisplayName])
}

model RefreshToken {
  id             String    @id @db.Uuid
  accountId      String    @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash      String
  device         String    @default("Unknown device")
  browser        String    @default("Unknown browser")
  ipAddress      String    @default("unknown")
  userAgent      String?
  lastActivityAt DateTime  @default(now()) @db.Timestamptz
  expiresAt      DateTime  @db.Timestamptz
  revokedAt      DateTime? @db.Timestamptz
  revokeReason   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([accountId, revokedAt, expiresAt])
  @@index([lastActivityAt])
}

model Permission {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique
  moduleKey    String
  actionKey    String
  label        String
  description  String
  displayOrder Int
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz
  roles        RolePermission[]

  @@index([moduleKey, displayOrder])
}

model AccountRole {
  accountId  String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz
  assignedBy String?  @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([accountId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now()) @db.Timestamptz
  assignedBy   String?    @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model TicketTeam {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  name               String
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz
  memberships        TicketTeamMembership[]
  inboxConversations InboxConversation[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model TicketTeamMembership {
  teamId     String     @db.Uuid
  employeeId String     @db.Uuid
  active     Boolean    @default(true)
  team       TicketTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, employeeId])
  @@index([employeeId, active])
}

model Ticket {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  number           String
  title            String
  description      String
  status           TicketStatus       @default(BACKLOG)
  lastActiveStatus TicketStatus       @default(BACKLOG)
  priority         TicketPriority     @default(MEDIUM)
  priorityRank     Int                @default(2)
  teamId           String?            @db.Uuid
  employeeId       String?            @db.Uuid
  customerId       String?            @db.Uuid
  studentId        String?            @db.Uuid
  conversationId   String?            @db.Uuid
  dueAt            DateTime?          @db.Timestamptz
  tags             String[]           @default([])
  completedAt      DateTime?          @db.Timestamptz
  archivedAt       DateTime?          @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz
  version          Int                @default(1)
  activitySequence Int                @default(0)
  createdBy        String             @db.Uuid
  updatedBy        String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  comments         TicketComment[]
  activities       TicketActivity[]
  attachments      TicketAttachment[]

  @@unique([organizationId, number])
  @@index([organizationId, archivedAt, status, updatedAt, id])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, archivedAt, priorityRank, updatedAt, id])
}

model TicketComment {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @db.Uuid
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId   String    @db.Uuid
  authorName String
  message    String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime? @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz

  @@index([ticketId, createdAt, id])
}

model TicketActivity {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sequence   Int
  type       String
  actorId    String   @db.Uuid
  actorName  String
  message    String
  payload    Json
  occurredAt DateTime @default(now()) @db.Timestamptz

  @@unique([ticketId, sequence])
  @@index([ticketId, sequence])
}

model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  name        String
  mimeType    String
  sizeBytes   Int
  storageId   String
  storageName String
  uploadedBy  String   @db.Uuid
  uploadedAt  DateTime @default(now()) @db.Timestamptz
  uploadKey   String?

  @@unique([ticketId, uploadKey])
  @@index([ticketId, uploadedAt, id])
}

model TicketCounter {
  organizationId String @id @db.Uuid
  nextNumber     Int    @default(1001)
}

enum InboxConversationStatus {
  OPEN
  PENDING
  SNOOZED
  CLOSED
  ARCHIVED
}

enum InboxMessageDirection {
  INCOMING
  OUTGOING
}

enum InboxMessageDelivery {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model InboxPlatform {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  label          String
  icon           String
  active         Boolean                  @default(true)
  conversations  InboxConversation[]
  channels       InboxChannelConnection[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model InboxTag {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  label          String
  color          String
  active         Boolean                @default(true)
  conversations  InboxConversationTag[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model InboxCustomer {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  normalizedName  String
  phone           String
  normalizedPhone String
  avatarUrl       String?
  contactId       String?             @db.Uuid
  contact         Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  firstContactAt  DateTime            @db.Timestamptz
  lastActivityAt  DateTime            @db.Timestamptz
  conversations   InboxConversation[]

  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, normalizedName])
  @@index([contactId])
}

model InboxConversation {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String                   @db.Uuid
  customer           InboxCustomer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  platformId         String                   @db.Uuid
  platform           InboxPlatform            @relation(fields: [platformId], references: [id], onDelete: Restrict)
  providerThreadId   String?
  status             InboxConversationStatus  @default(OPEN)
  previousStatus     InboxConversationStatus?
  assignedEmployeeId String?                  @db.Uuid
  assignedEmployee   Account?                 @relation("InboxAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedTeamId     String?                  @db.Uuid
  assignedTeam       TicketTeam?              @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  unreadCount        Int                      @default(0)
  lastMessage        String
  lastActivityAt     DateTime                 @db.Timestamptz
  closedAt           DateTime?                @db.Timestamptz
  deletedAt          DateTime?                @db.Timestamptz
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @db.Timestamptz
  messages           InboxMessage[]
  notes              InboxInternalNote[]
  tags               InboxConversationTag[]
  assignmentHistory  InboxAssignmentHistory[]
  systemEvents       InboxSystemEvent[]

  @@unique([platformId, providerThreadId])
  @@index([organizationId, deletedAt, lastActivityAt, id])
  @@index([organizationId, status, lastActivityAt])
  @@index([organizationId, assignedEmployeeId, lastActivityAt])
  @@index([organizationId, assignedTeamId, lastActivityAt])
  @@index([customerId])
  @@index([platformId])
}

model InboxConversationTag {
  conversationId String            @db.Uuid
  tagId          String            @db.Uuid
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            InboxTag          @relation(fields: [tagId], references: [id], onDelete: Restrict)
  addedAt        DateTime          @default(now()) @db.Timestamptz
  addedBy        String            @db.Uuid

  @@id([conversationId, tagId])
  @@index([tagId, conversationId])
}

model InboxMessage {
  id                String                   @id @default(uuid()) @db.Uuid
  conversationId    String                   @db.Uuid
  conversation      InboxConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         InboxMessageDirection
  senderName        String
  body              String
  sentAt            DateTime                 @db.Timestamptz
  delivery          InboxMessageDelivery
  retryToken        String?
  providerMessageId String?                  @unique
  createdBy         String?                  @db.Uuid
  attachments       InboxMessageAttachment[]

  @@unique([conversationId, retryToken])
  @@index([conversationId, sentAt, id])
}

/// `storageKey`/`sizeBytes`/`ownerAccountId` are set for attachments the
/// server stored (agent replies). Inbound attachments from a provider
/// webhook carry only the real provider metadata — no bytes are fabricated,
/// so those columns stay null until a deployment adds authenticated media
/// retrieval from Meta.
model InboxMessageAttachment {
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @db.Uuid
  message         InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceId        String
  kind            String
  fileName        String
  sizeBytes       Int?
  storageKey      String?
  ownerAccountId  String?      @db.Uuid
  durationSeconds Int?

  @@index([messageId])
  @@index([ownerAccountId, sourceId])
}

model InboxStagedAttachment {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerAccountId      String       @db.Uuid
  ownerAccount        Account      @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  kind                String
  fileName            String
  mimeType            String
  sizeBytes           Int
  storageId           String
  storageName         String
  createdAt           DateTime     @default(now()) @db.Timestamptz
  expiresAt           DateTime     @db.Timestamptz
  consumedAt          DateTime?    @db.Timestamptz
  consumedByMessageId String?      @db.Uuid

  @@index([organizationId, ownerAccountId, consumedAt, expiresAt])
  @@index([expiresAt])
}

model InboxInternalNote {
  id               String            @id @default(uuid()) @db.Uuid
  conversationId   String            @db.Uuid
  conversation     InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorEmployeeId String            @db.Uuid
  authorEmployee   Account           @relation(fields: [authorEmployeeId], references: [id], onDelete: Restrict)
  authorName       String
  content          String
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime?         @db.Timestamptz

  @@index([conversationId, createdAt])
}

model InboxAssignmentHistory {
  id                 String            @id @default(uuid()) @db.Uuid
  conversationId     String            @db.Uuid
  conversation       InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  previousEmployeeId String?           @db.Uuid
  previousTeamId     String?           @db.Uuid
  nextEmployeeId     String?           @db.Uuid
  nextTeamId         String?           @db.Uuid
  actorId            String            @db.Uuid
  actorName          String
  occurredAt         DateTime          @default(now()) @db.Timestamptz

  @@index([conversationId, occurredAt])
}

model InboxSystemEvent {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  label          String
  actorId        String            @db.Uuid
  actorName      String
  payload        Json?
  occurredAt     DateTime          @default(now()) @db.Timestamptz

  @@index([conversationId, occurredAt])
}

enum InboxChannelProvider {
  META_WHATSAPP
  META_MESSENGER
  META_INSTAGRAM
}

enum InboxChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// A linked provider account (WhatsApp Business number, Facebook Page, or
/// Instagram professional account) that feeds one inbox platform. Credentials
/// are stored encrypted; the plaintext token never leaves the channel service.
model InboxChannelConnection {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformId        String               @db.Uuid
  platform          InboxPlatform        @relation(fields: [platformId], references: [id], onDelete: Restrict)
  provider          InboxChannelProvider
  providerAccountId String
  businessAccountId String?
  displayName       String
  accountLabel      String?
  accessToken       String
  tokenExpiresAt    DateTime?            @db.Timestamptz
  scopes            String[]             @default([])
  status            InboxChannelStatus   @default(CONNECTED)
  lastError         String?
  lastVerifiedAt    DateTime?            @db.Timestamptz
  lastInboundAt     DateTime?            @db.Timestamptz
  connectedById     String               @db.Uuid
  connectedBy       Account              @relation(fields: [connectedById], references: [id], onDelete: Restrict)
  connectedByName   String
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @db.Timestamptz
  updatedAt         DateTime             @updatedAt @db.Timestamptz
  whatsappTemplates WhatsappTemplate[]
  campaigns         Campaign[]

  @@unique([provider, providerAccountId])
  @@index([organizationId, status])
  @@index([platformId])
  @@index([connectedById])
}

// ---------------------------------------------------------------------------
// CRM — contacts
// ---------------------------------------------------------------------------

enum ContactSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBSITE
  PHONE
  MANUAL
  IMPORT
}

enum ContactFieldKind {
  TEXT
  NUMBER
  DATE
}

model Contact {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  normalizedName  String
  phone           String
  normalizedPhone String
  secondaryPhone  String?
  email           String?
  normalizedEmail String?
  company         String?
  jobTitle        String?
  source          ContactSource        @default(MANUAL)
  channelHandle   String?
  ownerAccountId  String?              @db.Uuid
  owner           Account?             @relation(fields: [ownerAccountId], references: [id], onDelete: SetNull)
  ownerName       String
  lastActivityAt  DateTime             @db.Timestamptz
  deletedAt       DateTime?            @db.Timestamptz
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @db.Timestamptz
  updatedAt       DateTime             @updatedAt @db.Timestamptz
  createdBy       String?              @db.Uuid
  updatedBy       String?              @db.Uuid
  groups          ContactGroupMember[]
  customValues    ContactCustomValue[]
  notes           ContactNote[]
  leads           Lead[]
  inboxCustomers  InboxCustomer[]
  campaignSends   CampaignRecipient[]

  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, deletedAt, lastActivityAt, id])
  @@index([organizationId, normalizedName])
  @@index([organizationId, source])
  @@index([ownerAccountId])
}

model ContactGroup {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  description    String               @default("")
  active         Boolean              @default(true)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz
  updatedAt      DateTime             @updatedAt @db.Timestamptz
  members        ContactGroupMember[]
  campaigns      CampaignAudience[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, active])
}

model ContactGroupMember {
  contactId String       @db.Uuid
  groupId   String       @db.Uuid
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt   DateTime     @default(now()) @db.Timestamptz
  addedBy   String       @db.Uuid

  @@id([contactId, groupId])
  @@index([groupId, contactId])
}

model ContactCustomField {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label           String
  normalizedLabel String
  kind            ContactFieldKind
  displayOrder    Int                  @default(0)
  active          Boolean              @default(true)
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @db.Timestamptz
  updatedAt       DateTime             @updatedAt @db.Timestamptz
  values          ContactCustomValue[]

  @@unique([organizationId, normalizedLabel])
  @@index([organizationId, active, displayOrder])
}

model ContactCustomValue {
  contactId String             @db.Uuid
  fieldId   String             @db.Uuid
  contact   Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field     ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  updatedAt DateTime           @updatedAt @db.Timestamptz

  @@id([contactId, fieldId])
  @@index([fieldId])
}

model ContactNote {
  id              String    @id @default(uuid()) @db.Uuid
  contactId       String    @db.Uuid
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorAccountId String    @db.Uuid
  author          Account   @relation(fields: [authorAccountId], references: [id], onDelete: Restrict)
  authorName      String
  content         String
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime? @db.Timestamptz

  @@index([contactId, createdAt])
  @@index([authorAccountId])
}

// ---------------------------------------------------------------------------
// CRM — lead pipeline
// ---------------------------------------------------------------------------

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadOutcome {
  OPEN
  WON
  LOST
}

enum LeadActivityKind {
  CREATED
  STAGE_CHANGED
  ASSIGNED
  UPDATED
  NOTE
}

model Pipeline {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  isDefault      Boolean         @default(false)
  active         Boolean         @default(true)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz
  stages         PipelineStage[]
  leads          Lead[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PipelineStage {
  id          String      @id @default(uuid()) @db.Uuid
  pipelineId  String      @db.Uuid
  pipeline    Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String      @default("")
  probability Int         @default(0)
  accent      String      @default("slate")
  outcome     LeadOutcome @default(OPEN)
  position    Int
  isEntry     Boolean     @default(false)
  active      Boolean     @default(true)
  version     Int         @default(1)
  leads       Lead[]

  @@unique([pipelineId, code])
  @@index([pipelineId, position])
}

model Lead {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId      String         @db.Uuid
  pipeline        Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId         String         @db.Uuid
  stage           PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contactId       String         @db.Uuid
  contact         Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedAgentId String?        @db.Uuid
  assignedAgent   Account?       @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  priority        LeadPriority   @default(MEDIUM)
  valueMinor      BigInt         @default(0)
  currency        String
  precision       Int            @default(2)
  program         String         @default("")
  outcome         LeadOutcome    @default(OPEN)
  nextActionAt    DateTime?      @db.Timestamptz
  closedAt        DateTime?      @db.Timestamptz
  closeReason     String?
  deletedAt       DateTime?      @db.Timestamptz
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid
  activities      LeadActivity[]

  @@index([organizationId, deletedAt, updatedAt, id])
  @@index([pipelineId, stageId, updatedAt])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, outcome])
  @@index([contactId])
  @@index([stageId])
}

model LeadActivity {
  id         String           @id @default(uuid()) @db.Uuid
  leadId     String           @db.Uuid
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       LeadActivityKind
  label      String
  actorId    String?          @db.Uuid
  actorName  String
  payload    Json?
  occurredAt DateTime         @default(now()) @db.Timestamptz

  @@index([leadId, occurredAt, id])
}

// ---------------------------------------------------------------------------
// Campaigns — bulk WhatsApp sends built on approved Meta templates
// ---------------------------------------------------------------------------

enum WhatsappTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum CampaignEventKind {
  CREATED
  UPDATED
  AUDIENCE_BUILT
  STARTED
  PAUSED
  RESUMED
  CANCELLED
  COMPLETED
  DELIVERY_FAILED
}

/// A message template mirrored from a WhatsApp Business Account.
///
/// Templates are authored and approved on Meta's side; this table is a
/// read-through cache so the composer can list them without a Graph round trip,
/// and so a running campaign keeps the wording and variable count it was
/// planned against even when the template is edited upstream.
model WhatsappTemplate {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId        String?                 @db.Uuid
  connection          InboxChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  wabaId              String
  providerTemplateId  String
  name                String
  language            String
  category            String                  @default("MARKETING")
  status              WhatsappTemplateStatus  @default(PENDING)
  headerKind          String?
  headerText          String?
  bodyText            String
  footerText          String?
  buttons             Json?
  /// Positional `{{n}}` placeholders in the body, and in a text header.
  variableCount       Int                     @default(0)
  headerVariableCount Int                     @default(0)
  qualityScore        String?
  rejectedReason      String?
  syncedAt            DateTime                @db.Timestamptz
  createdAt           DateTime                @default(now()) @db.Timestamptz
  updatedAt           DateTime                @updatedAt @db.Timestamptz
  campaigns           Campaign[]

  @@unique([organizationId, providerTemplateId])
  @@index([organizationId, status, name])
  @@index([connectionId])
}

model Campaign {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  normalizedName    String
  description       String                  @default("")
  templateId        String                  @db.Uuid
  template          WhatsappTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  connectionId      String?                 @db.Uuid
  connection        InboxChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  status            CampaignStatus          @default(DRAFT)
  /// One entry per positional placeholder: `{ position, source, value }`, where
  /// source is `contact` (a built-in column), `field` (a custom field id), or
  /// `literal` (the same text for everyone).
  variableMap       Json                    @default("[]")
  headerVariableMap Json                    @default("[]")
  /// Messages handed to Meta per minute. The Cloud API accepts far more; the
  /// cap exists so one campaign cannot starve conversational replies.
  throttlePerMinute Int                     @default(120)
  scheduledAt       DateTime?               @db.Timestamptz
  startedAt         DateTime?               @db.Timestamptz
  completedAt       DateTime?               @db.Timestamptz
  totalRecipients   Int                     @default(0)
  sentCount         Int                     @default(0)
  deliveredCount    Int                     @default(0)
  readCount         Int                     @default(0)
  failedCount       Int                     @default(0)
  skippedCount      Int                     @default(0)
  lastError         String?
  createdById       String                  @db.Uuid
  createdByAccount  Account                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdByName     String
  deletedAt         DateTime?               @db.Timestamptz
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @db.Timestamptz
  updatedAt         DateTime                @updatedAt @db.Timestamptz
  updatedBy         String?                 @db.Uuid
  audiences         CampaignAudience[]
  recipients        CampaignRecipient[]
  events            CampaignEvent[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, deletedAt, createdAt, id])
  @@index([organizationId, status, scheduledAt])
  @@index([templateId])
  @@index([connectionId])
  @@index([createdById])
}

/// The contact groups a campaign draws its audience from. Kept after the
/// audience is materialised so operators can see which source groups produced
/// the frozen recipient snapshot.
model CampaignAudience {
  campaignId String       @db.Uuid
  groupId    String       @db.Uuid
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      ContactGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  addedAt    DateTime     @default(now()) @db.Timestamptz

  @@id([campaignId, groupId])
  @@index([groupId])
}

/// One planned send. This table is also the work queue: the dispatcher claims
/// `PENDING` rows whose `availableAt` has passed, with `SKIP LOCKED` so several
/// application instances never claim the same recipient.
model CampaignRecipient {
  id                String                  @id @default(uuid()) @db.Uuid
  campaignId        String                  @db.Uuid
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String?                 @db.Uuid
  contact           Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name              String
  phone             String
  normalizedPhone   String
  status            CampaignRecipientStatus @default(PENDING)
  /// The rendered positional values, frozen when the audience is built.
  variables         String[]                @default([])
  headerVariables   String[]                @default([])
  attempts          Int                     @default(0)
  providerMessageId String?                 @unique
  errorCode         String?
  errorMessage      String?
  availableAt       DateTime                @default(now()) @db.Timestamptz
  sentAt            DateTime?               @db.Timestamptz
  deliveredAt       DateTime?               @db.Timestamptz
  readAt            DateTime?               @db.Timestamptz
  failedAt          DateTime?               @db.Timestamptz
  createdAt         DateTime                @default(now()) @db.Timestamptz
  updatedAt         DateTime                @updatedAt @db.Timestamptz

  @@unique([campaignId, normalizedPhone])
  @@index([status, availableAt])
  @@index([campaignId, status, createdAt, id])
  @@index([contactId])
}

model CampaignEvent {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @db.Uuid
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       CampaignEventKind
  label      String
  actorId    String?           @db.Uuid
  actorName  String
  payload    Json?
  occurredAt DateTime          @default(now()) @db.Timestamptz

  @@index([campaignId, occurredAt, id])
}
