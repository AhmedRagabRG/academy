  id            String           @id @default(uuid()) @db.Uuid
  admissionId   String           @db.Uuid
  admission     Admission        @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  fromStatus    AdmissionStatus?
  toStatus      AdmissionStatus
  reason        String?
  actorId       String           @db.Uuid
  actorName     String
  sourceVersion Int
  resultVersion Int
  occurredAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([admissionId, resultVersion])
  @@index([admissionId, occurredAt, id])
}

model AdmissionTimelineEvent {
  id                     String                     @id @default(uuid()) @db.Uuid
  admissionId            String                     @db.Uuid
  admission              Admission                  @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  kind                   AdmissionTimelineEventKind
  sourceAdmissionVersion Int
  resultAdmissionVersion Int
  actorId                String                     @db.Uuid
  actorName              String
  metadata               Json
  occurredAt             DateTime                   @default(now()) @db.Timestamptz

  @@index([admissionId, occurredAt, id])
}

model AdmissionRequestKey {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  operationScope     String
  idempotencyKey     String
  requestFingerprint String
  targetId           String?                @db.Uuid
  resultPayload      Json?
  status             AdmissionRequestStatus @default(PROCESSING)
  createdAt          DateTime               @default(now()) @db.Timestamptz
  updatedAt          DateTime               @updatedAt @db.Timestamptz

  @@unique([organizationId, operationScope, idempotencyKey])
}

model AdmissionReferenceCounter {
  organizationId String   @db.Uuid
  year           Int
  nextValue      Int      @default(1)
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@id([organizationId, year])
}

// ═══════════════════════════ STUDENTS ═══════════════════════════
// Feature 008. Students are produced only by admission intake; there is no
// create or delete surface. Operational eligibility is derived from
// documentCompletion, never stored — see specs/008-student-management/research.md R-006.

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  ARCHIVED
}

enum StudentEnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  WITHDRAWN
}

enum StudentOfferingKind {
  PROFESSIONAL_PROGRAM
  PROFESSIONAL_DIPLOMA
  TRAINING_COURSE
}

enum StudentDocumentState {
  MISSING
  PRESENT
  ARCHIVED
}

enum StudentTimelineCategory {
  ADMISSION_SUBMITTED
  ADMISSION_APPROVED
  STUDENT_CREATED
  ENROLLMENT_ADDED
  DOCUMENT_UPLOADED
  DOCUMENT_REPLACED
  DOCUMENT_ARCHIVED
  PROFILE_UPDATED
  STATUS_CHANGED
  FINANCIAL_EVENT
  ACADEMIC_EVENT
}

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  studentCode    String
  status         StudentStatus @default(ACTIVE)

  fullName                  String
  searchName                String
  primaryPhone              String
  guardianName              String?
  guardianPhone             String?
  nationalId                String?
  normalizedNationalId      String?
  alternativeIdentityReason String?
  address                   String
  dateOfBirth               DateTime @db.Date
  qualificationId           String   @db.Uuid
  qualificationLabel        String
  graduationYear            Int
  profileImageFileId        String?
  profileImageUrl           String?

  registrationBranchId        String  @db.Uuid
  registrationBranchLabel     String
  studyBranchId               String  @db.Uuid
  studyBranchLabel            String
  departmentId                String  @db.Uuid
  departmentLabel             String
  academicGradeId             String? @db.Uuid
  academicGradeLabel          String?
  customerServiceEmployeeId   String  @db.Uuid
  customerServiceEmployeeName String

  admissionId        String   @db.Uuid
  admissionReference String
  approvalSnapshotId String   @db.Uuid
  admissionDate      DateTime @db.Date
  enrollmentDate     DateTime @db.Date

  archivedAt       DateTime? @db.Timestamptz
  archiveReason    String?
  timelineSequence Int       @default(0)
  version          Int       @default(1)

  createdAt     DateTime @default(now()) @db.Timestamptz
  createdById   String   @db.Uuid
  createdByName String
  updatedAt     DateTime @updatedAt @db.Timestamptz
  updatedById   String   @db.Uuid
  updatedByName String

  enrollments    StudentEnrollment[]
  documents      StudentDocument[]
  notes          StudentNote[]
  statusHistory  StudentStatusChange[]
  timelineEvents StudentTimelineEvent[]

  @@unique([organizationId, studentCode])
  @@unique([organizationId, normalizedNationalId])
  @@unique([organizationId, approvalSnapshotId])
  @@index([organizationId, status])
  @@index([organizationId, registrationBranchId])
  @@index([organizationId, studyBranchId])
  @@index([organizationId, departmentId])
  @@index([organizationId, customerServiceEmployeeId])
  @@index([organizationId, updatedAt])
  @@index([searchName])
}

model StudentEnrollment {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  offeringKind                StudentOfferingKind
  offeringId                  String              @db.Uuid
  offeringVersionAtEnrollment Int
  offeringLabel               String
  offeringCode                String
  batchId                     String?             @db.Uuid
  batchVersionAtEnrollment    Int?
  batchLabel                  String?
  batchCode                   String?

  registrationBranchLabel String
  studyBranchLabel        String
  academicYear            Int
  enrollmentDate          DateTime                @db.Date
  status                  StudentEnrollmentStatus @default(ACTIVE)
  sourceAdmissionId       String                  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([studentId])
  @@index([offeringId])
  @@index([batchId])
}

model StudentDocument {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  typeKey          String
  state            StudentDocumentState     @default(PRESENT)
  currentVersionId String?                  @unique @db.Uuid
  currentVersion   StudentDocumentVersion?  @relation("CurrentStudentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions         StudentDocumentVersion[] @relation("StudentDocumentVersions")

  archivedAt    DateTime? @db.Timestamptz
  archiveReason String?
  version       Int       @default(1)

  createdAt   DateTime @default(now()) @db.Timestamptz
  createdById String   @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz
  updatedById String   @db.Uuid

  @@index([studentId, typeKey])
}

model StudentDocumentVersion {
  id                 String           @id @default(uuid()) @db.Uuid
  documentId         String           @db.Uuid
  document           StudentDocument  @relation("StudentDocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentForDocument StudentDocument? @relation("CurrentStudentDocumentVersion")

  versionNumber  Int
  storageFileId  String
  fileDescriptor Json
  fileName       String
  mimeType       String
  byteSize       Int
  previewLocator String?

  uploadAttemptId String
  uploadedAt      DateTime @default(now()) @db.Timestamptz
  uploadedById    String   @db.Uuid
  uploadedByName  String

  // Provenance only. Deliberately NOT a foreign key — a relation into
  // AdmissionDocumentVersion would couple the two modules' rows and break the
  // independence FR-009 requires.
  copiedFromAdmissionVersionId String? @db.Uuid

  @@unique([documentId, versionNumber])
  @@unique([documentId, uploadAttemptId])
}

model StudentStatusChange {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  fromStatus StudentStatus?
  toStatus   StudentStatus
  reason     String?

  actorId       String   @db.Uuid
  actorName     String
  occurredAt    DateTime @default(now()) @db.Timestamptz
  sourceVersion Int
  resultVersion Int

  @@index([studentId, occurredAt])
}

model StudentNote {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  content    String
  authorId   String   @db.Uuid
  authorName String
  createdAt  DateTime @default(now()) @db.Timestamptz

  editedAt     DateTime? @db.Timestamptz
  editedById   String?   @db.Uuid
  editedByName String?
  archivedAt   DateTime? @db.Timestamptz

  @@index([studentId, createdAt])
}

model StudentTimelineEvent {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  category   StudentTimelineCategory
  occurredAt DateTime                @default(now()) @db.Timestamptz
  sequence   Int

  actorId    String  @db.Uuid
  actorName  String
  origin     String
  subjectRef String?
  summary    String

  @@unique([studentId, sequence])
  @@index([studentId, sequence(sort: Desc)])
}

model StudentIntakeKey {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  approvalSnapshotId String   @db.Uuid
  studentId          String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  @@unique([organizationId, approvalSnapshotId])
}

model StudentCodeCounter {
  organizationId String   @db.Uuid
  academicYear   Int
  branchId       String   @db.Uuid
  nextValue      Int      @default(1)
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@id([organizationId, academicYear, branchId])
}

// ---------------------------------------------------------------------------
// Student Finance (module 009)
//
// Money is BigInt minor units plus currency/precision, never a float or
// Decimal. Cross-module identifiers (student, enrollment, offering, batch,
// branch, lookup value, employee) are plain UUID columns with no Prisma
// relation, matching Student.admissionId: Finance validates them through the
// owning module's public port and never joins a foreign table
// (constitution Principle II).
//
// Balances are NOT stored. finance_invoice_balance (created in the migration)
// projects final/collected/netPaid/remaining/derivedStatus/isOverdue from
// these tables on demand, so there is no second source of truth that can
// drift from the payments and reductions that produced it.
// ---------------------------------------------------------------------------

enum FinanceOfferingKind {
  PROFESSIONAL_PROGRAM
  PROFESSIONAL_DIPLOMA
  TRAINING_COURSE
}

/// PARTIALLY_PAID and PAID are derivation outputs only. A CHECK constraint in
/// the migration restricts the stored column to DRAFT/ISSUED/CANCELLED so a
/// transition can never write a status that contradicts recorded money.
enum FinanceInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Derived from payments and the due date; never stored on Installment.
enum FinanceInstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum FinanceRefundStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum FinanceReductionKind {
  PERCENTAGE
  AMOUNT
}

enum FinanceScholarshipCoverage {
  FULL_TUITION
  PARTIAL_TUITION
}

enum FinanceScheduleBasis {
  WEEKLY
  MONTHLY
  BIMONTHLY
  CUSTOM
}

enum InstallmentFrequency {
  WEEKLY
  MONTHLY
  BIMONTHLY
}

enum FinanceReductionSourceKind {
  DISCOUNT
  SCHOLARSHIP
}

enum FinanceEventCategory {
  INVOICE_CREATED
  INVOICE_ISSUED
  INVOICE_CANCELLED
  INSTALLMENT_PLAN_GENERATED
  PAYMENT_RECEIVED
  DISCOUNT_APPLIED
  SCHOLARSHIP_APPLIED
  ADJUSTMENT_RECORDED
  REFUND_REQUESTED
  REFUND_COMPLETED
}

enum FinanceSequenceKind {
  INVOICE
  RECEIPT
}

/// Exactly one per student, provisioned by the student.created event. Holds no
/// balance column: outstanding balance, total charges and financial status are
/// derived on read.
model StudentFinancialAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  studentId      String @unique @db.Uuid
  studentCode    String
  studentName    String
  searchName     String
  currency       String
  precision      Int

  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz
  createdById String   @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz
  updatedById String   @db.Uuid

  snapshots StudentEnrollmentFinancialSnapshot[]
  invoices  Invoice[]

  @@index([organizationId, searchName])
  @@index([organizationId, studentCode])
}

/// Written once at enrollment from the Admissions approval snapshot. A trigger
/// rejects UPDATE and DELETE, which is what makes "future pricing changes never
/// modify existing student accounts" structural rather than procedural.
model StudentEnrollmentFinancialSnapshot {
  id        String                  @id @default(uuid()) @db.Uuid
  accountId String                  @db.Uuid
  account   StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  enrollmentId  String              @unique @db.Uuid
  offeringId    String              @db.Uuid
  offeringKind  FinanceOfferingKind
  offeringLabel String
  batchId       String?             @db.Uuid
  batchLabel    String?
  branchId      String              @db.Uuid

  sourceAdmissionId         String @db.Uuid
  sourceApprovalSnapshotId  String @db.Uuid
  sourceFinancialRevisionId String @db.Uuid

  tuitionMinor           BigInt
  registrationFeesMinor  BigInt
  admissionDiscountMinor BigInt @default(0)
  requiredAmountMinor    BigInt
  currency               String
  precision              Int

  snapshotAt   DateTime @default(now()) @db.Timestamptz
  snapshotById String   @db.Uuid

  @@index([accountId])
  @@index([offeringId])
  @@index([batchId])
}

/// The versioned charge aggregate. An additional charge is an invoice on a
/// non-tuition charge purpose.
model Invoice {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  invoiceNumber  String
  accountId      String                  @db.Uuid
  account        StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  studentId   String @db.Uuid
  studentCode String
  studentName String
  searchName  String

  enrollmentId  String              @db.Uuid
  branchId      String              @db.Uuid
  offeringId    String              @db.Uuid
  offeringLabel String
  offeringKind  FinanceOfferingKind
  batchId       String?             @db.Uuid
  batchLabel    String?

  /// FK-free reference to the FINANCE_CHARGE_PURPOSE lookup value. Adding a
  /// fee type is a lookup row, never a code change (Principle XIX).
  chargePurposeValueId String @db.Uuid
  chargePurposeCode    String

  issueDate DateTime? @db.Date
  dueDate   DateTime  @db.Date
  currency  String
  precision Int

  draftTotalMinor            BigInt
  draftDiscountTotalMinor    BigInt @default(0)
  draftScholarshipTotalMinor BigInt @default(0)
  draftFinalMinor            BigInt

  /// Written exactly once at issuance. A trigger rejects any UPDATE that
  /// changes a non-null issued column.
  issuedTotalMinor            BigInt?
  issuedDiscountTotalMinor    BigInt?
  issuedScholarshipTotalMinor BigInt?
  issuedFinalMinor            BigInt?

  status       FinanceInvoiceStatus @default(DRAFT)
  cancelledAt  DateTime?            @db.Timestamptz
  cancelReason String?

  version       Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz
  createdById   String   @db.Uuid
  createdByName String
  updatedAt     DateTime @updatedAt @db.Timestamptz
  updatedById   String   @db.Uuid
  updatedByName String

  statusHistory InvoiceStatusChange[]
  plan          InstallmentPlan?
  installments  Installment[]
  payments      Payment[]
  discounts     Discount[]
  adjustments   FinancialAdjustment[]
  refunds       Refund[]

  @@unique([organizationId, invoiceNumber])
  @@unique([enrollmentId, chargePurposeValueId])
  @@index([organizationId, branchId, status])
  @@index([organizationId, studentId])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([organizationId, offeringId])
  @@index([organizationId, batchId])
  @@index([organizationId, updatedAt])
  @@index([searchName])
  @@index([accountId])
}

/// Append-only. UPDATE and DELETE rejected by trigger.
model InvoiceStatusChange {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  fromStatus FinanceInvoiceStatus?
  toStatus   FinanceInvoiceStatus
  reason     String?
  actorId    String                @db.Uuid
  actorName  String
  occurredAt DateTime              @default(now()) @db.Timestamptz

  resultInvoiceVersion Int

  @@unique([invoiceId, resultInvoiceVersion])
  @@index([invoiceId, occurredAt])
}

model InstallmentPlan {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @unique @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  count         Int
  scheduleBasis FinanceScheduleBasis
  firstDueDate  DateTime             @db.Date

  generatedAt     DateTime @default(now()) @db.Timestamptz
  generatedById   String   @db.Uuid
  generatedByName String

  installments Installment[]
}

/// paidAmount, remaining and status are derived from payments and the due
/// date; they are deliberately absent as columns.
model Installment {
  id     String          @id @default(uuid()) @db.Uuid
  planId String          @db.Uuid
  plan   InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  sequence    Int
  dueDate     DateTime @db.Date
  amountMinor BigInt

  payments Payment[]

  @@unique([planId, sequence])
  @@index([invoiceId])
  @@index([dueDate])
}

/// Immutable. No update or delete path exists at any layer; a trigger rejects
/// both. Corrections go through a refund.
model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  receiptNumber  String

  studentId String  @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  installmentId String?      @db.Uuid
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  branchId String @db.Uuid

  /// FK-free reference to the FINANCE_PAYMENT_METHOD lookup value. Inactive
  /// methods stay resolvable so historical payments keep their label.
  methodId String @db.Uuid

  paymentDate DateTime @db.Date
  amountMinor BigInt
  currency    String
  precision   Int
  notes       String?

  recordedAt     DateTime @default(now()) @db.Timestamptz
  recordedById   String   @db.Uuid
  recordedByName String

  refunds Refund[]

  @@unique([organizationId, receiptNumber])
  @@index([invoiceId])
  @@index([installmentId])
  @@index([organizationId, studentId])
  @@index([organizationId, paymentDate])
  @@index([organizationId, methodId])
  @@index([organizationId, branchId])
}

/// Append-only invoice-level reduction.
model Discount {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  kind   FinanceReductionKind
  /// Percentage points scaled by 100 (e.g. 10.5% -> 1050) or minor units for
  /// a fixed amount. Integer either way; no float ever touches money.
  value  BigInt
  reason String

  approvedById   String   @db.Uuid
  approvedByName String
  approvedAt     DateTime @default(now()) @db.Timestamptz

  @@index([invoiceId])
}

/// Append-only student-level reduction. A null enrollmentId applies it to
/// every enrollment of that student.
model Scholarship {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  studentId      String  @db.Uuid
  enrollmentId   String? @db.Uuid

  name     String
  kind     FinanceReductionKind
  value    BigInt
  coverage FinanceScholarshipCoverage
  reason   String

  approvedById   String   @db.Uuid
  approvedByName String
  approvedAt     DateTime @default(now()) @db.Timestamptz

  @@index([organizationId, studentId])
  @@index([enrollmentId])
}

/// A reduction recorded AFTER issuance, so the issued snapshot is never
/// rewritten. Always a positive reduction amount.
model FinancialAdjustment {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  sourceKind FinanceReductionSourceKind
  sourceId   String                     @db.Uuid

  amountMinor BigInt
  currency    String
  precision   Int
  reason      String

  approvedById   String   @db.Uuid
  approvedByName String
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([invoiceId])
}

/// Only a COMPLETED refund reduces the collected total. Requesting and
/// authorizing are separate permissions.
model Refund {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  organizationId String @db.Uuid
  studentId      String @db.Uuid
  branchId       String @db.Uuid

  amountMinor BigInt
  currency    String
  precision   Int
  reason      String
  refundDate  DateTime @db.Date

  status FinanceRefundStatus @default(REQUESTED)

  requestedById   String   @db.Uuid
  requestedByName String
  requestedAt     DateTime @default(now()) @db.Timestamptz

  decidedById    String?   @db.Uuid
  decidedByName  String?
  decidedAt      DateTime? @db.Timestamptz
  decisionReason String?
  completedAt    DateTime? @db.Timestamptz

  version Int @default(1)

  @@index([paymentId, status])
  @@index([invoiceId])
  @@index([organizationId, studentId])
  @@index([organizationId, refundDate])
  @@index([organizationId, status])
  @@index([organizationId, branchId])
}

/// Append-only, cursor-paginated student activity record.
model FinanceTimelineEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  studentId      String  @db.Uuid
  invoiceId      String? @db.Uuid

  category   FinanceEventCategory
  occurredAt DateTime             @default(now()) @db.Timestamptz
  /// Per-student monotonic ordinal allocated in the same transaction as the
  /// event it describes. A timestamp cannot order events sharing a millisecond.
  sequence   Int

  actorId     String  @db.Uuid
  actorName   String
  subjectRef  String?
  amountMinor BigInt?
  currency    String?
  precision   Int?
  summary     String

  @@unique([studentId, sequence])
  @@index([studentId, sequence(sort: Desc)])
  @@index([organizationId, category])
}

/// Incremented under SELECT ... FOR UPDATE inside the allocating transaction,
/// never count + 1.
model FinanceNumberCounter {
  organizationId String              @db.Uuid
  sequenceKind   FinanceSequenceKind
  year           Int
  lastValue      Int                 @default(0)
  updatedAt      DateTime            @updatedAt @db.Timestamptz

  @@id([organizationId, sequenceKind, year])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  /// Settled: the approved amount has actually been disbursed. Distinct from
  /// APPROVED, which only authorises the spend.
  PAID
  ARCHIVED
}

enum ExpenseApprovalAction {
  CREATE
  SUBMIT
  REVIEW
  APPROVE
  REJECT
  RETURN
  PAY
  ARCHIVE
}

model ExpenseRequest {
  id               String   @id @default(cuid())
  expenseNumber    String   @unique
  branchId         String   @db.Uuid
  categoryId       String   @db.Uuid
  subcategoryId    String   @db.Uuid
  requestedById    String   @db.Uuid
  expenseDate      DateTime @db.Date
  description      String
  amount           String
  currency         String
  precision        Int
  status           ExpenseStatus @default(DRAFT)
  isArchived       Boolean  @default(false)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attachments      ExpenseAttachment[]
  approvalHistory  ExpenseApprovalHistory[]
  comments         ExpenseComment[]

  @@index([branchId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([requestedById])
  @@index([status])
  @@index([isArchived])
  @@index([createdAt])
  @@index([branchId, status])
}

model ExpenseAttachment {
  id               String   @id @default(cuid())
  expenseRequestId String
  fileName         String
  fileReference    String
  mimeType         String
  fileSize         Int
  uploadAttemptId  String   @unique
  uploadedAt       DateTime @default(now())
  uploadedById     String   @db.Uuid
  /// Denormalised so an attachment keeps the name of whoever uploaded it even
  /// if that account is later renamed or deactivated.
  uploadedByName   String   @default("")

  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)

  @@index([expenseRequestId])
  @@index([uploadedById])
}

model ExpenseApprovalHistory {
  id               String   @id @default(cuid())
  expenseRequestId String
  action           ExpenseApprovalAction
  previousStatus   String?
  newStatus        String
  performedById    String   @db.Uuid
  /// Denormalised for the same reason: approval history is an audit record and
  /// must not change meaning when an account does.
  performedByName  String   @default("")
  performedAt      DateTime @default(now())
  comment          String?

  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)

  @@index([expenseRequestId])
  @@index([performedById])
  @@index([performedAt])
}

/// Discussion on a request, deliberately separate from ExpenseApprovalHistory.
///
/// The history is the audit record and nothing a commenter writes may dilute
/// it; keeping the two in different tables is what makes that structural
/// rather than a convention. There is no update or delete: a comment, once
/// made, stays part of what the reviewers saw.
model ExpenseComment {
  id               String   @id @default(cuid())
  expenseRequestId String
  body             String
  authorId         String   @db.Uuid
  /// Denormalised, like the history's actor, so a comment keeps the name of
  /// whoever wrote it even after that account is renamed.
  authorName       String   @default("")
  createdAt        DateTime @default(now())

  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)

  @@index([expenseRequestId, createdAt])
  @@index([authorId])
}
