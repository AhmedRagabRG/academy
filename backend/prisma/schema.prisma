generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductTypeIdentity {
  PROFESSIONAL_PROGRAM
  PROFESSIONAL_DIPLOMA
  TRAINING_COURSE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  CLOSED
  ARCHIVED
}

enum ProductFieldKind {
  NUMBER
  OPTION
  BOOLEAN
  REFERENCE
}

enum ProductBranchRole {
  REGISTRATION
  STUDY
  GENERAL
}

enum ProductContentKind {
  FAQ
  ADMISSION_REQUIREMENT
  REQUIRED_DOCUMENT
}

enum ProductAssetKind {
  PRIMARY
  GALLERY
  BROCHURE
  VIDEO
}

enum BatchStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  STUDYING
  GRADUATED
  ARCHIVED
}

enum BatchBranchRole {
  REGISTRATION
  STUDY
}

enum InstallmentBasis {
  AMOUNT
  PERCENTAGE
}

enum CoveredCharge {
  PROGRAM_PRICE
  REGISTRATION_FEE
  COMBINED
}

enum BatchOfferKind {
  DISCOUNT
  SCHOLARSHIP
}

enum BatchValueType {
  AMOUNT
  PERCENTAGE
}

enum ConfigurationStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationContactType {
  EMAIL
  PHONE
}

enum ApplicantStatus {
  ACTIVE
  ARCHIVED
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ENROLLED
  ARCHIVED
}

enum AdmissionOfferingKind {
  PROFESSIONAL_PROGRAM
  PROFESSIONAL_DIPLOMA
  TRAINING_COURSE
}

enum EligibilityContext {
  SELECTION
  SUBMISSION
  APPROVAL
}

enum FinancialSourceKind {
  CATALOG_OFFERING
  PROGRAM_BATCH
}

enum DiscountMode {
  NONE
  PERCENTAGE
  AMOUNT
}

enum AdmissionDocumentVersionStatus {
  AVAILABLE
  FAILED
  WITHDRAWN
}

enum AdmissionDocumentDecisionKind {
  VERIFIED
  REJECTED
}

enum AdmissionTimelineEventKind {
  CREATED
  APPLICANT_UPDATED
  NOTES_UPDATED
  ASSIGNMENT_CHANGED
  SELECTION_CHANGED
  FINANCIAL_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_REPLACED
  DOCUMENT_WITHDRAWN
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  POLICY_REFRESHED
  STATUS_CHANGED
  APPROVED
  REJECTED
  ARCHIVED
  ENROLLED
}

enum AdmissionRequestStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING
  REVIEW
  DONE
  ARCHIVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id              String                   @id @default(uuid()) @db.Uuid
  singletonKey    String                   @unique @default("PRIMARY")
  code            String                   @unique
  name            String
  logo            Json?
  favicon         Json?
  cover           Json?
  website         String?
  address         String?
  workingHours    Json
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @db.Timestamptz
  createdBy       String?                  @db.Uuid
  updatedBy       String?                  @db.Uuid
  contacts        OrganizationContact[]
  socialLinks     OrganizationSocialLink[]
  generalSettings GeneralSettings?
  branches        Branch[]
  departments     Department[]
  academicYears   AcademicYear[]
  lookupGroups    LookupGroup[]
  inboxPlatforms  InboxPlatform[]
  inboxTags       InboxTag[]
  inboxCustomers  InboxCustomer[]
  inboxConversations InboxConversation[]
  inboxStagedAttachments InboxStagedAttachment[]
}

model OrganizationContact {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           OrganizationContactType
  label          String
  value          String
  isPrimary      Boolean                 @default(false)
  sortOrder      Int                     @default(0)

  @@index([organizationId, type, sortOrder])
}

model OrganizationSocialLink {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       String
  url            String
  sortOrder      Int          @default(0)

  @@unique([organizationId, platform])
  @@index([organizationId, sortOrder])
}

model GeneralSettings {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @unique @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultLanguage       String
  timeZone              String
  currency              String
  dateFormat            String
  numberFormat          String
  workingDays           String[]
  defaultBranchId       String       @db.Uuid
  defaultBranch         Branch       @relation(fields: [defaultBranchId], references: [id], onDelete: Restrict)
  defaultAcademicYearId String       @db.Uuid
  defaultAcademicYear   AcademicYear @relation(fields: [defaultAcademicYearId], references: [id], onDelete: Restrict)
  version               Int          @default(1)
  createdAt             DateTime     @default(now()) @db.Timestamptz
  updatedAt             DateTime     @updatedAt @db.Timestamptz
  createdBy             String?      @db.Uuid
  updatedBy             String?      @db.Uuid

  @@index([defaultBranchId])
  @@index([defaultAcademicYearId])
}

model Branch {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  normalizedName   String
  code             String
  address          String
  phone            String
  email            String
  managerId        String?                 @db.Uuid
  workingHours     String
  status           EntityStatus            @default(ACTIVE)
  version          Int                     @default(1)
  archivedAt       DateTime?               @db.Timestamptz
  createdAt        DateTime                @default(now()) @db.Timestamptz
  updatedAt        DateTime                @updatedAt @db.Timestamptz
  createdBy        String?                 @db.Uuid
  updatedBy        String?                 @db.Uuid
  generalSettings  GeneralSettings[]
  batchAssignments BatchBranchAssignment[]
  inboxCustomers    InboxCustomer[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([normalizedName])
  @@index([updatedAt])
  @@index([managerId])
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  normalizedName String
  code           String
  description    String
  status         EntityStatus @default(ACTIVE)
  version        Int          @default(1)
  archivedAt     DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([normalizedName])
  @@index([updatedAt])
}

model AcademicYear {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name            String
  normalizedName  String
  code            String
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date
  status          EntityStatus      @default(INACTIVE)
  version         Int               @default(1)
  archivedAt      DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  createdBy       String?           @db.Uuid
  updatedBy       String?           @db.Uuid
  terms           AcademicTerm[]
  generalSettings GeneralSettings[]
  programBatches  ProgramBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([startDate])
  @@index([normalizedName])
}

model AcademicTerm {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String
  normalizedName String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  order          Int
  status         EntityStatus @default(ACTIVE)
  version        Int          @default(1)
  archivedAt     DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid

  @@unique([academicYearId, order], map: "AcademicTerm_academicYearId_order_key")
  @@index([academicYearId, status, startDate])
  @@index([organizationId])
  @@index([normalizedName])
  @@index([updatedAt])
}

model LookupGroup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  normalizedName String
  parentGroupId  String?       @db.Uuid
  parentGroup    LookupGroup?  @relation("LookupGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  childGroups    LookupGroup[] @relation("LookupGroupHierarchy")
  status         EntityStatus  @default(ACTIVE)
  version        Int           @default(1)
  archivedAt     DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  createdBy      String?       @db.Uuid
  updatedBy      String?       @db.Uuid
  values         LookupValue[]

  @@unique([organizationId, code])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, status])
  @@index([parentGroupId])
}

model LookupValue {
  id             String         @id @default(uuid()) @db.Uuid
  lookupGroupId  String         @db.Uuid
  lookupGroup    LookupGroup    @relation(fields: [lookupGroupId], references: [id], onDelete: Restrict)
  parentValueId  String?        @db.Uuid
  parentValue    LookupValue?   @relation("LookupValueHierarchy", fields: [parentValueId], references: [id], onDelete: Restrict)
  childValues    LookupValue[]  @relation("LookupValueHierarchy")
  name           String
  normalizedName String
  code           String
  /// Optional prose describing the value. Expense categories carry one; most
  /// lookup groups leave it null.
  description    String?
  sortOrder      Int            @default(0)
  status         EntityStatus   @default(ACTIVE)
  version        Int            @default(1)
  archivedAt     DateTime?      @db.Timestamptz
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz
  createdBy      String?        @db.Uuid
  updatedBy      String?        @db.Uuid
  programBatches ProgramBatch[]

  @@unique([lookupGroupId, code])
  @@unique([lookupGroupId, normalizedName])
  @@index([lookupGroupId, status, sortOrder])
  @@index([parentValueId])
}

model Role {
  id                    String           @id @default(uuid()) @db.Uuid
  code                  String           @unique
  displayName           String
  normalizedDisplayName String           @unique
  description           String           @default("")
  status                EntityStatus     @default(ACTIVE)
  version               Int              @default(1)
  archivedAt            DateTime?        @db.Timestamptz
  createdAt             DateTime         @default(now()) @db.Timestamptz
  updatedAt             DateTime         @updatedAt @db.Timestamptz
  createdBy             String?          @db.Uuid
  updatedBy             String?          @db.Uuid
  accounts              AccountRole[]
  permissions           RolePermission[]
}

model Account {
  id                    String         @id @default(uuid()) @db.Uuid
  email                 String         @unique
  passwordHash          String
  displayName           String
  normalizedDisplayName String
  phone                 String         @default("+2000000000")
  position              String?
  departmentId          String?        @db.Uuid
  branchIds             String[]       @default([])
  organizationWide      Boolean        @default(false)
  avatar                Json?
  status                EntityStatus   @default(ACTIVE)
  version               Int            @default(1)
  archivedAt            DateTime?      @db.Timestamptz
  createdAt             DateTime       @default(now()) @db.Timestamptz
  updatedAt             DateTime       @updatedAt @db.Timestamptz
  createdBy             String?        @db.Uuid
  updatedBy             String?        @db.Uuid
  roles                 AccountRole[]
  refreshTokens         RefreshToken[]
  inboxAssignedConversations InboxConversation[] @relation("InboxAssignedEmployee")
  inboxNotes             InboxInternalNote[]
  inboxStagedAttachments InboxStagedAttachment[]

  @@index([status])
  @@index([departmentId])
  @@index([normalizedDisplayName])
}

model RefreshToken {
  id             String    @id @db.Uuid
  accountId      String    @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash      String
  device         String    @default("Unknown device")
  browser        String    @default("Unknown browser")
  ipAddress      String    @default("unknown")
  userAgent      String?
  lastActivityAt DateTime  @default(now()) @db.Timestamptz
  expiresAt      DateTime  @db.Timestamptz
  revokedAt      DateTime? @db.Timestamptz
  revokeReason   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([accountId, revokedAt, expiresAt])
  @@index([lastActivityAt])
}

model Permission {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique
  moduleKey    String
  actionKey    String
  label        String
  description  String
  displayOrder Int
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz
  roles        RolePermission[]

  @@index([moduleKey, displayOrder])
}

model AccountRole {
  accountId  String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz
  assignedBy String?  @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([accountId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now()) @db.Timestamptz
  assignedBy   String?    @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model TicketTeam {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  name           String
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz
  memberships    TicketTeamMembership[]
  inboxConversations InboxConversation[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model TicketTeamMembership {
  teamId     String     @db.Uuid
  employeeId String     @db.Uuid
  active     Boolean    @default(true)
  team       TicketTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, employeeId])
  @@index([employeeId, active])
}

model Ticket {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  number           String
  title            String
  description      String
  status           TicketStatus     @default(BACKLOG)
  lastActiveStatus TicketStatus     @default(BACKLOG)
  priority         TicketPriority   @default(MEDIUM)
  priorityRank     Int              @default(2)
  departmentId     String           @db.Uuid
  branchId         String?          @db.Uuid
  teamId           String?          @db.Uuid
  employeeId       String?          @db.Uuid
  customerId       String?          @db.Uuid
  studentId        String?          @db.Uuid
  conversationId   String?          @db.Uuid
  dueAt            DateTime?        @db.Timestamptz
  tags             String[]         @default([])
  completedAt      DateTime?        @db.Timestamptz
  archivedAt       DateTime?        @db.Timestamptz
  deletedAt        DateTime?        @db.Timestamptz
  version          Int              @default(1)
  activitySequence Int              @default(0)
  createdBy        String           @db.Uuid
  updatedBy        String           @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz
  comments         TicketComment[]
  activities       TicketActivity[]
  attachments      TicketAttachment[]

  @@unique([organizationId, number])
  @@index([organizationId, archivedAt, status, updatedAt, id])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, branchId, status])
  @@index([organizationId, archivedAt, priorityRank, updatedAt, id])
}

model TicketComment {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @db.Uuid
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId   String    @db.Uuid
  authorName String
  message    String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime? @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz

  @@index([ticketId, createdAt, id])
}

model TicketActivity {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sequence   Int
  type       String
  actorId    String   @db.Uuid
  actorName  String
  message    String
  payload    Json
  occurredAt DateTime @default(now()) @db.Timestamptz

  @@unique([ticketId, sequence])
  @@index([ticketId, sequence])
}

model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  name        String
  mimeType    String
  sizeBytes   Int
  storageId   String
  storageName String
  uploadedBy  String   @db.Uuid
  uploadedAt  DateTime @default(now()) @db.Timestamptz
  uploadKey   String?

  @@unique([ticketId, uploadKey])
  @@index([ticketId, uploadedAt, id])
}

model TicketCounter {
  organizationId String @id @db.Uuid
  nextNumber     Int    @default(1001)
}

enum InboxConversationStatus {
  OPEN
  PENDING
  SNOOZED
  CLOSED
  ARCHIVED
}

enum InboxMessageDirection {
  INCOMING
  OUTGOING
}

enum InboxMessageDelivery {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model InboxPlatform {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  label          String
  icon           String
  active         Boolean      @default(true)
  conversations  InboxConversation[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model InboxTag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  label          String
  color          String
  active         Boolean      @default(true)
  conversations  InboxConversationTag[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model InboxCustomer {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String       @db.Uuid
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name            String
  normalizedName  String
  phone           String
  normalizedPhone String
  avatarUrl       String?
  firstContactAt  DateTime     @db.Timestamptz
  lastActivityAt  DateTime     @db.Timestamptz
  conversations   InboxConversation[]

  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, branchId, lastActivityAt])
  @@index([organizationId, normalizedName])
}

model InboxConversation {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String                  @db.Uuid
  customer           InboxCustomer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  platformId         String                  @db.Uuid
  platform           InboxPlatform           @relation(fields: [platformId], references: [id], onDelete: Restrict)
  providerThreadId   String?
  status             InboxConversationStatus @default(OPEN)
  previousStatus     InboxConversationStatus?
  assignedEmployeeId String?                 @db.Uuid
  assignedEmployee   Account?                @relation("InboxAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedTeamId     String?                 @db.Uuid
  assignedTeam       TicketTeam?             @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  unreadCount        Int                     @default(0)
  lastMessage        String
  lastActivityAt     DateTime                @db.Timestamptz
  closedAt           DateTime?               @db.Timestamptz
  deletedAt          DateTime?               @db.Timestamptz
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @db.Timestamptz
  updatedAt          DateTime                @updatedAt @db.Timestamptz
  messages           InboxMessage[]
  notes              InboxInternalNote[]
  tags               InboxConversationTag[]
  assignmentHistory  InboxAssignmentHistory[]
  systemEvents       InboxSystemEvent[]

  @@index([organizationId, deletedAt, lastActivityAt, id])
  @@index([organizationId, status, lastActivityAt])
  @@index([organizationId, assignedEmployeeId, lastActivityAt])
  @@index([organizationId, assignedTeamId, lastActivityAt])
  @@index([customerId])
  @@index([platformId])
  @@unique([platformId, providerThreadId])
}

model InboxConversationTag {
  conversationId String            @db.Uuid
  tagId          String            @db.Uuid
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            InboxTag          @relation(fields: [tagId], references: [id], onDelete: Restrict)
  addedAt        DateTime          @default(now()) @db.Timestamptz
  addedBy        String            @db.Uuid

  @@id([conversationId, tagId])
  @@index([tagId, conversationId])
}

model InboxMessage {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @db.Uuid
  conversation   InboxConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      InboxMessageDirection
  senderName     String
  body           String
  sentAt         DateTime                @db.Timestamptz
  delivery       InboxMessageDelivery
  retryToken     String?
  providerMessageId String?                  @unique
  createdBy      String?                 @db.Uuid
  attachments    InboxMessageAttachment[]

  @@unique([conversationId, retryToken])
  @@index([conversationId, sentAt, id])
}

model InboxMessageAttachment {
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @db.Uuid
  message         InboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceId        String
  kind            String
  fileName        String
  sizeBytes       Int
  storageKey      String
  ownerAccountId  String       @db.Uuid
  durationSeconds Int?

  @@index([messageId])
  @@index([ownerAccountId, sourceId])
}

model InboxStagedAttachment {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerAccountId      String       @db.Uuid
  ownerAccount        Account      @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  kind                String
  fileName            String
  mimeType            String
  sizeBytes           Int
  storageId           String
  storageName         String
  createdAt           DateTime     @default(now()) @db.Timestamptz
  expiresAt           DateTime     @db.Timestamptz
  consumedAt          DateTime?    @db.Timestamptz
  consumedByMessageId String?      @db.Uuid

  @@index([organizationId, ownerAccountId, consumedAt, expiresAt])
