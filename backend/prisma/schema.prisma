/// Which module a configured requirement list governs. The two differ in shape
/// — Admissions stages a requirement by workflow status and verifies it,
/// Students allows repeated uploads of one type — so a list is written for one
/// module and never shared implicitly.
enum DocumentPolicyModule {
  ADMISSIONS
  STUDENTS
}

/// The editable source of truth for "which documents are asked for".
///
/// Before this existed the lists were hardcoded constants, so the only way to
/// stop asking for a document was a code change. A row with a null
/// `offeringId` is the organization-wide default; a row naming an offering
/// overrides that default for it alone. `version` is what an admission's
/// policy snapshot is compared against, so bumping it is what lets an existing
/// draft pick the change up through the refresh-policy route.
model DocumentRequirementPolicy {
  id             String                          @id @default(uuid()) @db.Uuid
  organizationId String                          @db.Uuid
  module         DocumentPolicyModule
  offeringId     String?                         @db.Uuid
  version        Int                             @default(1)
  createdAt      DateTime                        @default(now()) @db.Timestamptz
  updatedAt      DateTime                        @updatedAt @db.Timestamptz
  updatedById    String?                         @db.Uuid
  requirements   DocumentRequirementDefinition[]

  @@index([organizationId, module])
}

/// One configurable document type inside a policy.
///
/// `enabled` and `required` are deliberately separate: a document can be
/// offered but optional, which is not the same as not being asked for at all.
model DocumentRequirementDefinition {
  id               String                    @id @default(uuid()) @db.Uuid
  policyId         String                    @db.Uuid
  policy           DocumentRequirementPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stableKey        String
  label            String
  enabled          Boolean                   @default(true)
  required         Boolean                   @default(true)
  /// Admissions only — the stage the document must exist by.
  requiredAtStage  AdmissionStatus?
  /// Students only — whether repeated uploads of this type are kept.
  multiple         Boolean                   @default(false)
  allowedMimeTypes String[]
  maximumBytes     Int
  displayOrder     Int                       @default(0)

  @@unique([policyId, stableKey])
}

