# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser.

# Where the Next dev server forwards /api/v1/* (see next.config.ts rewrites).
# Server-side only, so it is not exposed to the browser.
API_PROXY_ORIGIN=http://localhost:3001

# Leave unset in development.
#
# Unset, the browser calls the same-origin /api/v1 and the rewrite above
# proxies it. That keeps the session cookie same-origin, so it is sent and set
# without the backend having to allow-list this origin for credentialed CORS.
#
# Set it to an absolute URL only when the API is addressed directly (a deployed
# API on its own domain). The rewrite then switches off, and the backend's
# CORS_ORIGINS must name this app's origin.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Set to true to run the whole app on in-memory fixtures instead of the API.
# The Playwright journeys need this: they drive deterministic states (empty,
# version conflict, permission denied) through the mock scenario controllers.
# NEXT_PUBLIC_API_MOCKS=true
